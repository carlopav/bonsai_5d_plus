# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Claude Code local settings
.claude/

# Build output
dist/

# Typst preview output, written next to the templates by editor extensions
src/bonsai_5d_plus/module/prints_manager/typst/*.pdf

# Stale zip in src/
src/*.zip

# Prezzari data files — never committed (DEI are private; the rest are heavy).
# Keep only the folder structure and README.
assets/prezzari/**
!assets/prezzari/**/
!assets/prezzari/README.md
!assets/prezzari/**/.gitkeep
